{
  "manifest_version": 3,
  "name": "2D Acessos",
  "version": "1.0.0",
  "description": "Abre o Price já logado e os links de BI de cada cliente, escolhendo por um popup — usa a mesma API da Carteira de Monitoria.",
  "icons": {
    "16": "icone-16.png",
    "32": "icone-32.png",
    "48": "icone-48.png",
    "128": "icone-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icone-16.png",
      "32": "icone-32.png",
      "48": "icone-48.png",
      "128": "icone-128.png"
    }
  },
  "permissions": ["scripting", "tabs"],
  "host_permissions": [
    "http://carteira.local:8080/*",
    "http://karol-2d:8080/*",
    "http://127.0.0.1:8080/*",
    "http://127.0.0.1:3011/*",
    "http://77.37.126.180:5005/*"
  ]
}
